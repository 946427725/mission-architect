{
  "name": "mission-architect",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Mission Architect - a space mission design game where real physics decides. NASA Space Apps Challenge 2026.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "build:single": "npm run build && node scripts/build-single.mjs",
    "build:exe": "npm run build:single && node scripts/build-exe.mjs"
  },
  "dependencies": {
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/three": "^0.187.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
